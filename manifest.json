{
  "manifest_version": 3,
  "name": "ToS & Privacy Risk Analyzer",
  "version": "1.0",
  "description": "Kullanım koşulları ve gizlilik politikalarındaki riskli maddeleri analiz eder.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  }
}